# Server Configuration
SERVER_PORT=8080
SERVER_TIMEOUT=30s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# gRPC Server configuration
GRPC_PORT=50051
GRPC_TLS_ENABLED=false
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=wallet

# Logging Configuration
LOG_LEVEL=info # debug, info, warn, error

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_CONN_MAX_LIFETIME=30m

# Blockchain configuration
ENABLE_BITCOIN=true
ENABLE_EVM=true
ENABLE_SOLANA=true
ENABLE_TRON=true

# Bitcoin Configuration
BITCOIN_RPC_ENDPOINT=https://blockchain.info
BITCOIN_NETWORK=mainnet

# EVM Chains Configuration (chainId:endpoint pairs, comma-separated)
EVM_ENDPOINTS=1:https://ethereum.publicnode.com,56:https://bsc.publicnode.com,137:https://polygon.publicnode.com

# Solana Configuration
SOLANA_RPC_URL=https://rpc.ankr.com/solana
SOLANA_ANKR_API_KEY=

# Tron Configuration
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=

# Ankr Provider Configuration
ANKR_API_KEY=your-ankr-api-key-here
ANKR_BASE_URL=rpc.ankr.com
# Optional: Override specific chain paths (format: chain:path,chain:path)
# ANKR_RPC_PATHS=eth:custom/path,bsc:other/path

# Node.js WebSocket Server configuration
NODE_SERVER_ENABLED=false
NODE_SERVER_URL=ws://localhost:3005/socket.io
NODE_SERVER_AUTH_TOKEN=your-auth-token
NODE_SERVER_USER_ID=go-server 